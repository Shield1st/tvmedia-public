<?xml version="1.0" encoding="utf-8"?>
<!--
  夸克登录页：一个 WebView + 顶部状态条。

  WebView 用桌面客户端 UA 加载 pan.quark.cn，登录页会直接给出二维码；
  用户用手机夸克 App 扫码后，Activity 自己从 CookieManager 抓 cookie 并返回。
  所以电视这一侧**不需要任何输入**，状态条与「重新加载」只是保险与逃生口。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="16dp"
        android:paddingEnd="48dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/showLoginButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_entry"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusDown="@id/webView"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp"
            android:text="@string/quark_login_show_dialog"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/reloadButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_entry"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusDown="@id/webView"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp"
            android:text="@string/quark_login_reload"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:nextFocusUp="@id/reloadButton" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingStart="48dp"
        android:paddingTop="8dp"
        android:paddingEnd="48dp"
        android:paddingBottom="16dp"
        android:text="@string/quark_login_hint"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

</LinearLayout>
